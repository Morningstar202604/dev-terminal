{
    "name": "quiet-light",
    "settings": [{
        "settings": {
            "background": "#FBFBF9",
            "foreground": "#2F353B",
            "lineHighlight": "#F2F3F0",
            "selection": "#DCE4EC",
            "highlightedDelimitersForeground": "#B4682B"
        }
    },
        {
            "name": "Comment",
            "scope": "comment,comment.line,comment.block,punctuation.definition.comment",
            "settings": {
                "foreground": "#9BA5AC"
            }
        },
        {
            "name": "Strings",
            "scope": "string,string.quoted,string.character.escape,string.template.quoted,string.template.quoted.punctuation,string.template.quoted.punctuation.single,string.template.quoted.punctuation.double,string.type.declaration.annotation,string.template.quoted.punctuation.tag,string.quoted.double,string.quoted.single",
            "settings": {
                "foreground": "#3F8560"
            }
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric,constant.language,constant.character,constant.other",
            "settings": {
                "foreground": "#B06A34"
            }
        },
        {
            "name": "Keywords",
            "scope": "keyword,keyword.control,keyword.operator.new,keyword.other,storage,storage.type,storage.modifier,keyword.control.flow,keyword.control.loop,keyword.control.conditional,keyword.control.trycatch,keyword.control.import,keyword.control.directive",
            "settings": {
                "foreground": "#7A5DB8"
            }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator,keyword.operator.logical,keyword.operator.relational,keyword.operator.assignment,keyword.operator.comparison,keyword.operator.ternary,keyword.operator.arithmetic,keyword.operator.spread,keyword.operator.word",
            "settings": {
                "foreground": "#6B7681"
            }
        },
        {
            "name": "Functions",
            "scope": "entity.name.function,support.function,meta.function-call,meta.function-call.generic,variable.function,entity.name.function.member",
            "settings": {
                "foreground": "#2C6BA8"
            }
        },
        {
            "name": "Types & Classes",
            "scope": "entity.name.type,entity.name.class,entity.other.inherited-class,support.type,support.class,entity.name.namespace,entity.name.scope-resolution,storage.type.java,storage.type.primitive",
            "settings": {
                "foreground": "#2F7F83"
            }
        },
        {
            "name": "Variables & Parameters",
            "scope": "variable,variable.other,variable.parameter,meta.definition.variable,variable.other.readwrite,variable.other.property,variable.other.object",
            "settings": {
                "foreground": "#2F353B"
            }
        },
        {
            "name": "Constants & Builtins",
            "scope": "support.constant,variable.other.constant,constant.language.boolean,support.type.python,support.function.builtin",
            "settings": {
                "foreground": "#B06A34"
            }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation,punctuation.definition,punctuation.separator,punctuation.terminator,punctuation.accessor,punctuation.section,punctuation.definition.parameters,punctuation.definition.arguments,meta.brace",
            "settings": {
                "foreground": "#7D868E"
            }
        },
        {
            "name": "Decorators & Annotations",
            "scope": "entity.name.function.decorator,meta.attribute,storage.type.annotation,punctuation.definition.annotation,entity.name.tag,support.type.property-name",
            "settings": {
                "foreground": "#B0648A"
            }
        },
        {
            "name": "Markup Headings",
            "scope": "markup.heading,entity.name.section,markup.bold",
            "settings": {
                "foreground": "#2C6BA8",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup Links",
            "scope": "markup.underline.link,string.other.link",
            "settings": {
                "foreground": "#2C6BA8",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Invalid",
            "scope": "invalid,invalid.illegal,invalid.deprecated",
            "settings": {
                "foreground": "#C0493B"
            }
        }
    ]
}
