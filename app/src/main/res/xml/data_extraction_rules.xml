<?xml version="1.0" encoding="utf-8"?>
<!--
  备份/迁移数据抽取规则（Android 12+ / API 31+）。
  App 整体已设 allowBackup="false"，此处作为纵深防御：
  显式排除存放 AI API Key 与内嵌 token 的加密 SharedPreferences，
  确保其不会随云备份或设备对设备迁移被带走。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="devterminal_encrypted.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="devterminal_encrypted.xml" />
    </device-transfer>
</data-extraction-rules>
